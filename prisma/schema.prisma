generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lot {
  id                  String   @id @default(cuid())
  golfClub            String
  location            String
  expiry              DateTime
  format              String
  startingBidPence    Int      @default(0)
  minimumIncrementPence Int    @default(500)
  displayOrder        Int      @default(0)
  active              Boolean  @default(true)
  bids                Bid[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Bid {
  id          String   @id @default(cuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bidderName  String
  amountPence Int
  createdAt   DateTime @default(now())

  @@index([lotId, amountPence])
  @@index([lotId, createdAt])
}
model SquareBoard {
  id            String @id
  closed        Boolean @default(false)
  winningSquare String?
}

model SquarePurchase {
  id            String @id @default(uuid())
  boardId       String
  buyerName     String
  squares       String[]
  amountPence   Int
  status        String @default("PENDING")
  checkoutId    String? @unique
  checkoutUrl   String?
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  claims        SquareClaim[]

  @@index([boardId, status, expiresAt])
}

// A claim remains exclusive until SumUp confirms payment or expiry.
model SquareClaim {
  boardId    String
  code       String
  purchaseId String
  purchase   SquarePurchase @relation(fields: [purchaseId], references: [id])

  @@id([boardId, code])
  @@index([purchaseId])
}

model BreakfastEntry {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique
  createdAt DateTime @default(now())
}

model BreakfastDraw {
  id           String    @id
  winnerIds    String[]  @default([])
  winnerNames  String[]  @default([])
  entrantCount Int?
  drawnAt      DateTime?
}
